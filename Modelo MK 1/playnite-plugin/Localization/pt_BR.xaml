<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCBibliotecaRAApiKeyLabel">Web API Key:</sys:String>
    <sys:String x:Key="LOCBibliotecaRAApiKeyHelp">Pegue sua chave em retroachievements.org → Control Panel → Keys. A chave fica só nas configurações locais e nunca entra no código.</sys:String>
    <sys:String x:Key="LOCBibliotecaRAUsernameLabel">Usuário do RetroAchievements:</sys:String>
    <sys:String x:Key="LOCBibliotecaRAUsernameHelp">Seu nome de usuário no site (não é a chave). Importa só os jogos da sua conta.</sys:String>
    <sys:String x:Key="LOCBibliotecaRAFoldersLabel">Pastas de ROM para varrer:</sys:String>
    <sys:String x:Key="LOCBibliotecaRAAddFolder">Adicionar pasta</sys:String>
    <sys:String x:Key="LOCBibliotecaRARemoveFolder">Remover pasta</sys:String>
    <sys:String x:Key="LOCBibliotecaRAImportGameFolders">Importar pastas dos jogos</sys:String>
    <sys:String x:Key="LOCBibliotecaRAExtensionsLabel">Extensões de arquivo a verificar:</sys:String>
    <sys:String x:Key="LOCBibliotecaRAExtensionsTooltip">Lista separada por vírgulas, com ou sem ponto. Deixe vazio para verificar todos os arquivos.</sys:String>
    <sys:String x:Key="LOCBibliotecaRADetectLabel">Detectar ROMs instaladas por hash MD5</sys:String>
    <sys:String x:Key="LOCBibliotecaRAActivitySectionLabel">Atividade e tempo de jogo:</sys:String>
    <sys:String x:Key="LOCBibliotecaRASyncActivityLabel">Sincronizar última vez jogado (LastActivity)</sys:String>
    <sys:String x:Key="LOCBibliotecaRASyncPlaytimeLabel">Sincronizar tempo de jogo</sys:String>
    <sys:String x:Key="LOCBibliotecaRAActivityHelp">A cada atualização de biblioteca, lê do RetroAchievements a última vez que você jogou (só avança, nunca retrocede) e o tempo total por jogo. Na 1ª vez o tempo consulta 1 requisição por jogo (≈2–4 min para 500 jogos); depois só busca jogos novos ou que você jogou desde a última sincronização. O tempo aplicado só sobe: max(tempo local, tempo do RA).</sys:String>
    <sys:String x:Key="LOCBibliotecaRACacheLabel">Validade do cache:</sys:String>
    <sys:String x:Key="LOCBibliotecaRACacheUnit">horas (baixado de novo após esse período)</sys:String>
    <sys:String x:Key="LOCBibliotecaRATestButton">Testar conexão</sys:String>
    <sys:String x:Key="LOCBibliotecaRAForceButton">Forçar atualização da biblioteca</sys:String>
    <sys:String x:Key="LOCBibliotecaRAClearButton">Limpar cache</sys:String>

</ResourceDictionary>
